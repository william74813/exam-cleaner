{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exam-cleaner-proxy",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://william74813.github.io",
    "GEMINI_MODEL": "gemini-3.1-flash-image"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "ACCESS_TOKEN"
    ]
  },
  "ratelimits": [
    {
      "name": "CLEAN_RATE_LIMITER",
      "namespace_id": "22026",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
